# Run the setup command to generate a private .env with local-only credentials.
DOCUMENTDB_USERNAME=<local-username>
DOCUMENTDB_PASSWORD=<generated-local-password>
WORKSHOP_MODE=starter
WORKSHOP_LOCATION=laptop
WORKSHOP_PUBLIC_HOST=
WORKSHOP_PORT=3000
ACTIVE_TARGET=local
LOCAL_DATABASE_NAME=ato_workshop
# Leave these empty until an organizer supplies an approved sandbox.
CLOUD_DOCUMENTDB_URI=
CLOUD_DATABASE_NAME=
# Optional anonymous registry approved by your organization; never embed tokens.
NPM_REGISTRY=https://registry.npmjs.org/
