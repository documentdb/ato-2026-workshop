# Run setup; it generates private, independent local credentials.
DOCUMENTDB_USERNAME=<site-a-username>
DOCUMENTDB_PASSWORD=<generated-site-a-password>
SITE_B_USERNAME=<site-b-username>
SITE_B_PASSWORD=<different-generated-site-b-password>
WORKSHOP_MODE=starter
WORKSHOP_LOCATION=laptop
WORKSHOP_PUBLIC_HOST=
WORKSHOP_PORT=3000
# Host/outer-dev-container loopback ports for the VS Code extension, not app DNS.
# If occupied, choose two distinct unused ports; never stop someone else's services.
SITE_A_EXTENSION_PORT=10270
SITE_B_EXTENSION_PORT=10271
# The attendee Compose file always starts at local (Site A).
# ACTIVE_TARGET is used only by the explicit presenter override.
ACTIVE_TARGET=local
LOCAL_DATABASE_NAME=ato_workshop
SITE_B_DATABASE_NAME=ato_workshop
# Presenter only. Default attendee Compose does NOT pass these into the app.
# Use an existing, approved Azure instance; no new subscription is required by attendees.
CLOUD_DOCUMENTDB_URI=
CLOUD_DATABASE_NAME=
# Optional anonymous registry approved by your organization; never embed tokens.
NPM_REGISTRY=https://registry.npmjs.org/
